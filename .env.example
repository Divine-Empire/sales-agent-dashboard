# Render backend base URL
SALES_AGENT_API_URL=https://your-service.onrender.com
# Shared secret sent as X-API-Key. Must match DASHBOARD_API_KEY on the backend.
# Server-side only — never NEXT_PUBLIC_.
SALES_AGENT_API_KEY=

# Protects the rendered CRM and every server-side mutation.
CRM_AUTH_PASSWORD=
# Generate a high-entropy value of at least 32 characters. Rotating it signs
# out every existing dashboard session.
CRM_SESSION_SECRET=
